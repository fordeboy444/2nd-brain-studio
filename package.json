{
  "name": "2nd-brain-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/",
    "test:all": "pnpm -r test && vitest run tests/"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}