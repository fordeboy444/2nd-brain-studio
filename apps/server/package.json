    "hono": "4.13.13",
    "jsdom": "30.1.3",
    "pino": "10.4.0",
    "turndown": "7.2.4",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "5.0.5"
