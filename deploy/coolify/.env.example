# 2nd Brain Studio — the variables a deployment may set.
#
# Copy the names into Coolify's Environment Variables for this resource and fill
# in your own values. Placeholder names only: this file is committed, so it must
# never carry a real key.
#
# Every one of these has a default in deploy/coolify/docker-compose.yml, so a
# deployment works with none of them set. An empty value means "not configured"
# — config.ts treats an empty string as an unset variable, the container still
# serves, and GET /api/health reports status "degraded".

# The port the process listens on inside the container. Must match the
# healthcheck and the exposed port in the compose file. Leave it alone.
PORT=3010

# Where vaults live. Must match the volume mount point; changing one without the
# other loses sight of every existing vault.
VAULT_ROOT=/data/vaults

# Ollama Cloud key. Empty means the LLM stages are not configured: no job starts
# and /api/health says so. Fill it in with your own key.
OLLAMA_API_KEY=

# Ollama Cloud endpoint and the model the generation stages call.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=llama3.1:8b

# Supadata key, the paid fallback for the YouTube transcript cascade when
# yt-dlp cannot fetch a transcript. Empty means the fallback is unavailable.
SUPADATA_API_KEY=

# Coolify's own variable. Leave it empty: Coolify generates a domain, writes it
# here, and terminates TLS for it. Set it only to point the app at a domain you
# already own.
SERVICE_FQDN_APP=
